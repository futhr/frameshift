{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    {
      "frameshift": "urn:frameshift:vocabulary:0.1#",
      "htv": "http://www.w3.org/2011/http#"
    }
  ],
  "id": "urn:frameshift:device:sim-photo-00000001",
  "title": "Frameshift simulated photo frame",
  "profile": ["urn:frameshift:profile:frame:0.1"],
  "base": "https://frame.invalid/",
  "securityDefinitions": {
    "mtls": {
      "scheme": "auto",
      "frameshift:mechanism": "mutual-tls"
    }
  },
  "security": ["mtls"],
  "properties": {
    "capabilities": {
      "type": "object",
      "readOnly": true,
      "forms": [{ "href": "v0/capabilities", "contentType": "application/json", "op": "readproperty" }]
    },
    "state": {
      "type": "object",
      "readOnly": true,
      "observable": true,
      "forms": [{ "href": "v0/state", "contentType": "application/json", "op": "readproperty" }]
    },
    "playlist": {
      "type": "object",
      "readOnly": true,
      "observable": true,
      "forms": [{ "href": "v0/playlist", "contentType": "application/json", "op": "readproperty" }]
    }
  },
  "actions": {
    "installAsset": {
      "idempotent": true,
      "input": {
        "type": "string",
        "contentEncoding": "binary",
        "contentMediaType": "application/vnd.frameshift.rgb24"
      },
      "output": { "type": "object" },
      "uriVariables": {
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "forms": [
        {
          "href": "v0/assets/sha256/{digest}",
          "contentType": "application/vnd.frameshift.rgb24",
          "op": "invokeaction",
          "htv:methodName": "PUT",
          "frameshift:artifactProfile": "urn:frameshift:profile:sim-rgb24-v1"
        }
      ]
    },
    "removeAsset": {
      "idempotent": true,
      "input": {
        "type": "object",
        "required": ["assetDigest"],
        "properties": {
          "assetDigest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      },
      "output": { "type": "object" },
      "forms": [
        {
          "href": "v0/actions/remove-asset",
          "contentType": "application/json",
          "op": "invokeaction",
          "htv:methodName": "DELETE"
        }
      ]
    },
    "setDesired": {
      "idempotent": true,
      "input": { "type": "object" },
      "output": { "type": "object" },
      "forms": [
        {
          "href": "v0/desired",
          "contentType": "application/json",
          "op": "invokeaction",
          "htv:methodName": "PUT"
        }
      ]
    },
    "replacePlaylist": {
      "idempotent": true,
      "input": { "type": "object" },
      "output": { "type": "object" },
      "forms": [
        {
          "href": "v0/playlist",
          "contentType": "application/json",
          "op": "invokeaction",
          "htv:methodName": "PUT"
        }
      ]
    },
    "retryDisplay": {
      "idempotent": true,
      "output": { "type": "object" },
      "forms": [
        {
          "href": "v0/actions/retry-display",
          "contentType": "application/json",
          "op": "invokeaction",
          "htv:methodName": "POST"
        }
      ]
    }
  },
  "events": {
    "stateChanged": {
      "data": { "type": "object" },
      "forms": [{ "href": "v0/events/state", "contentType": "text/event-stream", "subprotocol": "sse", "op": ["subscribeevent", "unsubscribeevent"] }]
    },
    "displayCompleted": {
      "data": { "type": "object" },
      "forms": [{ "href": "v0/events/display", "contentType": "text/event-stream", "subprotocol": "sse", "op": ["subscribeevent", "unsubscribeevent"] }]
    }
  },
  "frameshift:capabilities": {
    "protocolMajor": 0,
    "protocolMinor": 1,
    "deviceId": "sim-photo-00000001",
    "hardwareRevision": "simulated-photo-v1",
    "firmwareVersion": "simulator-0.1.0",
    "stillOnly": true,
    "transferModes": ["push", "pull"],
    "displayClass": "continuous-color-raster",
    "geometry": {
      "width": 1920,
      "height": 1080,
      "orientation": "identity",
      "safeInset": { "top": 0, "right": 0, "bottom": 0, "left": 0 },
      "pixelAspectRatio": { "horizontal": 1, "vertical": 1 }
    },
    "color": {
      "kind": "continuous",
      "colorSpaces": ["srgb"],
      "transferFunction": "srgb",
      "channelOrder": "rgb",
      "bitDepth": 8,
      "alphaHandling": "none",
      "profileRevision": "sim-srgb-v1"
    },
    "refresh": {
      "kind": "sample-and-hold",
      "typicalRefreshMs": 50,
      "maximumRefreshMs": 1000,
      "minimumDwellMs": 1000,
      "flashDuringRefresh": false
    },
    "power": {
      "class": "continuous-emissive",
      "source": "external",
      "remoteWake": true
    },
    "storage": {
      "maximumAssetBytes": 6220800,
      "totalBytes": 67108864,
      "availableBytes": 67108864,
      "maximumAssetCount": 32,
      "digestAlgorithms": ["sha-256"],
      "artifactProfiles": [
        {
          "id": "urn:frameshift:profile:sim-rgb24-v1",
          "mediaType": "application/vnd.frameshift.rgb24",
          "width": 1920,
          "height": 1080,
          "maximumAssetBytes": 6220800,
          "rowAlignment": 1,
          "byteOrder": "not-applicable",
          "channelOrder": "rgb",
          "bitDepth": 8,
          "compression": "none"
        }
      ],
      "maximumPlaylistLength": 32
    }
  }
}
