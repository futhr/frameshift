{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.frameshift.invalid/v0.1/playlist.schema.json",
  "title": "Frame Protocol v0.1 still-image playlist",
  "type": "object",
  "required": ["revision", "mode", "entries"],
  "properties": {
    "revision": { "$ref": "common.schema.json#/$defs/digest" },
    "mode": { "enum": ["hold", "cycle"] },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": ["assetDigest", "dwellMs"],
        "properties": {
          "assetDigest": { "$ref": "common.schema.json#/$defs/digest" },
          "dwellMs": { "type": "integer", "minimum": 1, "maximum": 31536000000 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
