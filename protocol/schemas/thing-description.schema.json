{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.frameshift.invalid/v0.1/thing-description.schema.json",
  "title": "Frameshift Frame Thing Description semantic overlay v0.1",
  "type": "object",
  "required": ["@context", "id", "title", "profile", "securityDefinitions", "security", "properties", "actions", "events", "frameshift:capabilities"],
  "properties": {
    "@context": {
      "oneOf": [
        { "const": "https://www.w3.org/2022/wot/td/v1.1" },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "contains": { "const": "https://www.w3.org/2022/wot/td/v1.1" }
        }
      ]
    },
    "id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "title": { "type": "string", "minLength": 1, "maxLength": 128 },
    "profile": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "contains": { "const": "urn:frameshift:profile:frame:0.1" },
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "securityDefinitions": { "type": "object", "minProperties": 1 },
    "security": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 64 }
    },
    "properties": {
      "type": "object",
      "required": ["capabilities", "state", "playlist"]
    },
    "actions": {
      "type": "object",
      "required": ["installAsset", "removeAsset", "setDesired", "replacePlaylist", "retryDisplay"]
    },
    "events": {
      "type": "object",
      "required": ["stateChanged", "displayCompleted"]
    },
    "forms": {
      "type": "array"
    },
    "frameshift:capabilities": { "$ref": "capabilities.schema.json" }
  },
  "additionalProperties": true
}
