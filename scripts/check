#!/bin/sh
set -eu

repository_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)

check_policy() {
  prohibited_files=$(
    git -C "$repository_root" ls-files --cached --others --exclude-standard -- \
      '*.py' '*.pyi' 'requirements*.txt' 'pyproject.toml'
  )

  if [ -n "$prohibited_files" ]; then
    echo "Repository-owned Python files are prohibited:" >&2
    echo "$prohibited_files" >&2
    return 1
  fi

  mise exec -- shellcheck \
    "$repository_root/.githooks/commit-msg" \
    "$repository_root/scripts/build-macos-icons" \
    "$repository_root/scripts/check" \
    "$repository_root/scripts/check-elixir-docs" \
    "$repository_root/scripts/check-core-release" \
    "$repository_root/scripts/check-packaged-app" \
    "$repository_root/scripts/format" \
    "$repository_root/scripts/frameshift-maintenance" \
    "$repository_root/scripts/index" \
    "$repository_root/scripts/launch-bundled-core" \
    "$repository_root/scripts/package-macos" \
    "$repository_root/host/core/test/fixtures/hanging-worker.sh"
  mise exec -- actionlint "$repository_root/.github/workflows/check.yml"
  "$repository_root/scripts/check-elixir-docs"
}

check_renderer() {
  (
    cd "$repository_root/renderer"
    mise exec -- zig fmt --check build.zig src
    mise exec -- zig build test
    mise exec -- zig build test -Doptimize=ReleaseSafe
    mise exec -- zig build -Doptimize=ReleaseSafe
  )
}

check_core() {
  (
    cd "$repository_root/host/core"
    mise exec -- env -u MIX_HOME -u MIX_ARCHIVES mix check
  )

  "$repository_root/scripts/check-core-release"
}

check_macos() {
  (
    cd "$repository_root/host/macos"
    swift format lint --recursive --strict Sources Tests Package.swift

    swiftc_path=$(xcrun --find swiftc)
    swift_usr=$(CDPATH='' cd -- "$(dirname -- "$swiftc_path")/.." && pwd)
    testing_macros="$swift_usr/lib/swift/host/plugins/testing/libTestingMacros.dylib"

    if [ -f "$testing_macros" ]; then
      swift test --parallel \
        -Xswiftc -load-plugin-library \
        -Xswiftc "$testing_macros"
    else
      swift test --parallel
    fi

    swift run frameshift-shell-checks
  )

  "$repository_root/scripts/package-macos" >/dev/null

  app_bundle="$repository_root/host/macos/.build/artifacts/Frameshift.app"
  test -x "$app_bundle/Contents/MacOS/Frameshift"
  test -x "$app_bundle/Contents/MacOS/frameshiftctl"
  test -x "$app_bundle/Contents/Resources/bin/frameshift-raster"
  test -x "$app_bundle/Contents/Resources/bin/frameshift-maintenance"
  test -x "$app_bundle/Contents/Resources/bin/launch-bundled-core"
  test -x "$app_bundle/Contents/Resources/core/bin/frameshift_core"
  test -s "$app_bundle/Contents/Resources/FrameshiftLight.icns"
  test -s "$app_bundle/Contents/Resources/FrameshiftDark.icns"
  test -s "$app_bundle/Contents/Resources/FrameshiftMenu.png"
  test -s "$app_bundle/Contents/Resources/FrameshiftMenu@2x.png"
  test -s "$app_bundle/Contents/Resources/FrameshiftMenu@3x.png"
  plutil -lint "$app_bundle/Contents/Info.plist" >/dev/null
  codesign --verify --deep --strict "$app_bundle"
  test "$(plutil -extract CFBundlePackageType raw "$app_bundle/Contents/Info.plist")" = "APPL"
  test "$(plutil -extract CFBundleIconFile raw "$app_bundle/Contents/Info.plist")" = "FrameshiftLight.icns"
  test "$(plutil -extract LSUIElement raw "$app_bundle/Contents/Info.plist")" = "true"

  "$repository_root/scripts/check-packaged-app" "$app_bundle"
}

check_container() {
  if ! docker info >/dev/null 2>&1; then
    echo "Docker-compatible daemon required for the frame receiver lane" >&2
    return 1
  fi

  (
    cd "$repository_root/host/core"
    mise exec -- env -u MIX_HOME -u MIX_ARCHIVES \
      FRAMESHIFT_CONTAINER_TESTS=1 \
      mix test test/frameshift/container_receiver_test.exs
  )
}

case "${1:-all}" in
  all)
    check_policy
    check_renderer
    check_core
    check_macos
    ;;
  policy) check_policy ;;
  renderer) check_renderer ;;
  core) check_core ;;
  macos) check_macos ;;
  container) check_container ;;
  *)
    echo "usage: scripts/check [all|policy|renderer|core|macos|container]" >&2
    exit 64
    ;;
esac
