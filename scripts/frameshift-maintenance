#!/bin/sh
set -eu

if [ "$#" -lt 2 ]; then
  echo "usage: frameshift-maintenance backup DESTINATION | verify BACKUP | restore BACKUP DESTINATION" >&2
  exit 64
fi

operation=$1
shift

case "$operation:$#" in
  backup:1)
    export FRAMESHIFT_MAINTENANCE_DESTINATION="$1"
    unset FRAMESHIFT_MAINTENANCE_SOURCE
    ;;
  verify:1)
    export FRAMESHIFT_MAINTENANCE_SOURCE="$1"
    unset FRAMESHIFT_MAINTENANCE_DESTINATION
    ;;
  restore:2)
    export FRAMESHIFT_MAINTENANCE_SOURCE="$1"
    export FRAMESHIFT_MAINTENANCE_DESTINATION="$2"
    ;;
  *)
    echo "usage: frameshift-maintenance backup DESTINATION | verify BACKUP | restore BACKUP DESTINATION" >&2
    exit 64
    ;;
esac

export FRAMESHIFT_MAINTENANCE_OPERATION="$operation"
script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
resources="$script_dir/.."
export FRAMESHIFT_RENDERER_PATH="$resources/bin/frameshift-raster"

exec "$resources/core/bin/frameshift_core" eval 'Frameshift.Library.Maintenance.run()'
