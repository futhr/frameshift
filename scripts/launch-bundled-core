#!/bin/sh
set -eu

if [ "$#" -ne 2 ]; then
  echo "usage: launch-bundled-core <parent-pid> <core-executable>" >&2
  exit 64
fi

parent_pid=$1
core=$2
core_pid=''
pid_file=${FRAMESHIFT_CORE_PID_FILE:-}

cleanup() {
  trap - EXIT HUP INT TERM

  if [ -n "$core_pid" ] && kill -0 "$core_pid" 2>/dev/null; then
    kill "$core_pid" 2>/dev/null || true
    wait "$core_pid" 2>/dev/null || true
  fi

  if [ -n "$pid_file" ]; then
    rm -f "$pid_file"
  fi
}

trap cleanup EXIT HUP INT TERM

"$core" start &
core_pid=$!

if [ -n "$pid_file" ]; then
  umask 077
  printf '%s\n' "$core_pid" >"$pid_file"
fi

while kill -0 "$parent_pid" 2>/dev/null && kill -0 "$core_pid" 2>/dev/null; do
  sleep 0.2
done

if kill -0 "$parent_pid" 2>/dev/null; then
  set +e
  wait "$core_pid"
  status=$?
  set -e
  core_pid=''
  exit "$status"
fi
